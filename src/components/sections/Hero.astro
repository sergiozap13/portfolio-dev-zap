---
import { profile } from '../../content/data';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
---

<section class="py-24 md:py-32">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mb-6">
      <Icon name="heroicons:map-pin" class="w-4 h-4 text-emerald-500" />
      <span>{profile.location}</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 mb-4">
      {profile.name}
    </h1>

    <p class="text-lg md:text-xl text-emerald-700 dark:text-emerald-400 font-semibold mb-8">
      {profile.title}
    </p>

    <p class="text-base md:text-lg leading-relaxed text-gray-600 dark:text-gray-400 max-w-3xl mb-10">
      {profile.bio}
    </p>

    <div class="flex flex-wrap gap-4">
      <a href="/CV_Sergio_Zapata.pdf" download class="group flex flex-col items-center justify-center px-6 py-4 bg-emerald-600 text-white rounded-lg hover:bg-emerald-500 transition-all duration-200 hover:scale-105">
        <Icon name="heroicons:document-arrow-down" class="w-8 h-8 mb-2" />
        <span class="text-sm font-medium">Descargar CV</span>
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center justify-center px-6 py-4 bg-emerald-500 text-gray-950 rounded-lg hover:bg-emerald-400 transition-all duration-200 hover:scale-105">
        <Icon name="simple-icons:github" class="w-8 h-8 mb-2" />
        <span class="text-sm font-medium">GitHub</span>
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="group flex flex-col items-center justify-center px-6 py-4 border-2 border-emerald-500 text-emerald-700 dark:text-emerald-400 rounded-lg hover:bg-emerald-50 dark:hover:bg-emerald-500/10 transition-all duration-200 hover:scale-105">
        <Icon name="simple-icons:linkedin" class="w-8 h-8 mb-2" />
        <span class="text-sm font-medium">LinkedIn</span>
      </a>
      <a href={`mailto:${profile.email}`} class="group flex flex-col items-center justify-center px-6 py-4 border-2 border-emerald-500 text-emerald-700 dark:text-emerald-400 rounded-lg hover:bg-emerald-50 dark:hover:bg-emerald-500/10 transition-all duration-200 hover:scale-105">
        <Icon name="heroicons:envelope" class="w-8 h-8 mb-2" />
        <span class="text-sm font-medium">Email</span>
      </a>
    </div>
  </div>
</section>
