---
import { experience } from '../../content/data';
import SectionTitle from '../ui/SectionTitle.astro';
import { Icon } from 'astro-icon/components';
---

<section class="py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-6">
    <SectionTitle id="experience" title="Experiencia" subtitle="Mi trayectoria profesional" />

    <div class="relative">
      <div class="absolute left-0 md:left-1/2 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-800 transform md:-translate-x-1/2"></div>

      <div class="space-y-12">
        {experience.map((exp, index) => (
          <div class={`relative flex flex-col md:flex-row ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'} items-start`}>
            <div class="absolute left-0 md:left-1/2 w-4 h-4 bg-emerald-500 rounded-full border-4 border-white dark:border-gray-950 transform -translate-x-1/2 mt-6 z-10"></div>

            <div class={`w-full md:w-1/2 ${index % 2 === 0 ? 'md:pr-12' : 'md:pl-12'} pl-8 md:pl-0`}>
              <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl p-6 transition-colors duration-200">
                <div class="flex items-start justify-between mb-3">
                  <div>
                    <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-1">
                      {exp.role}
                    </h3>
                    <p class="text-emerald-700 dark:text-emerald-400 font-semibold">
                      {exp.company}
                    </p>
                  </div>
                  <Icon name="heroicons:building-office-2" class="w-5 h-5 text-gray-400 dark:text-gray-600 flex-shrink-0" />
                </div>

                <div class="flex items-center gap-4 text-sm text-gray-600 dark:text-gray-400 mb-4">
                  <span class="flex items-center gap-1">
                    <Icon name="heroicons:calendar" class="w-4 h-4" />
                    {exp.startDate} - {exp.endDate}
                  </span>
                  <span class="flex items-center gap-1">
                    <Icon name="heroicons:map-pin" class="w-4 h-4" />
                    {exp.location}
                  </span>
                </div>

                <ul class="space-y-2">
                  {exp.bullets.map((bullet) => (
                    <li class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed flex items-start">
                      <span class="text-emerald-500 mr-2 mt-1">•</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="hidden md:block w-1/2"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
