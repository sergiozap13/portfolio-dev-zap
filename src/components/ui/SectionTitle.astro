---
interface Props {
  id: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<div class="mb-12 text-center">
  <h2 id={id} class="text-3xl md:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
      {subtitle}
    </p>
  )}
  <div class="mt-4 mx-auto w-16 h-1 bg-emerald-500 rounded-full"></div>
</div>
