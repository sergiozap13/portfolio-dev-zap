---
import { Icon } from 'astro-icon/components';

const navLinks = [
  { href: "#experience", label: "Experiencia" },
  { href: "#projects", label: "Proyectos" },
  { href: "#stack", label: "Stack" },
  { href: "#education", label: "Educación" }
];
---

<header class="sticky top-0 z-50 bg-white/80 dark:bg-gray-950/80 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-all duration-700 ease-in-out">
  <nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="#" class="text-xl font-bold text-gray-900 dark:text-gray-100 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-700 ease-in-out">
      Sergio Zapata
    </a>
    
    <div class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="text-gray-600 dark:text-gray-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-700 ease-in-out"
        >
          {link.label}
        </a>
      ))}
      
      <label class="relative inline-flex items-center cursor-pointer ml-4">
        <input type="checkbox" id="theme-toggle" class="sr-only peer" checked />
        <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-emerald-500 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all after:duration-700 after:ease-in-out dark:border-gray-600 peer-checked:bg-emerald-500">
        </div>
        <Icon name="heroicons:sun" class="ml-2 w-5 h-5 text-gray-600 dark:text-gray-400 transition-all duration-700 ease-in-out" />
      </label>
    </div>
    
    <button id="mobile-menu-toggle" class="md:hidden text-gray-600 dark:text-gray-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-700 ease-in-out">
      <Icon name="heroicons:bars-3" class="w-6 h-6" />
    </button>
  </nav>
  
  <div id="mobile-menu" class="md:hidden border-t border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950 overflow-hidden transition-all duration-700 ease-in-out max-h-0 opacity-0">
    <div class="px-6 py-4 space-y-3">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class="block text-gray-600 dark:text-gray-400 hover:text-emerald-600 dark:hover:text-emerald-400 transition-all duration-700 ease-in-out"
        >
          {link.label}
        </a>
      ))}
      
      <div class="pt-3 border-t border-gray-200 dark:border-gray-800">
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" id="theme-toggle-mobile" class="sr-only peer" checked />
          <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-emerald-500 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all after:duration-700 after:ease-in-out dark:border-gray-600 peer-checked:bg-emerald-500">
          </div>
          <Icon name="heroicons:sun" class="ml-2 w-5 h-5 text-gray-600 dark:text-gray-400 transition-all duration-700 ease-in-out" />
        </label>
      </div>
    </div>
  </div>
</header>

<script>
  const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const desktopToggle = document.getElementById('theme-toggle');
  const mobileToggle = document.getElementById('theme-toggle-mobile');
  
  mobileMenuToggle?.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('active')) {
      mobileMenu.classList.remove('active');
      mobileMenu.style.maxHeight = '0';
      mobileMenu.style.opacity = '0';
    } else {
      mobileMenu?.classList.add('active');
      mobileMenu!.style.maxHeight = mobileMenu!.scrollHeight + 'px';
      mobileMenu!.style.opacity = '1';
      mobileMenu!.style.transition = 'max-height 500ms ease-in-out, opacity 500ms ease-in-out';
    }
  });
  
  mobileToggle?.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).checked) {
      desktopToggle!.checked = true;
      desktopToggle!.dispatchEvent(new Event('change'));
    } else {
      desktopToggle!.checked = false;
      desktopToggle!.dispatchEvent(new Event('change'));
    }
  });
</script>
